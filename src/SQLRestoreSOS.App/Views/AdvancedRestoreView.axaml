<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:SQLRestoreSOS.App.ViewModels"
             mc:Ignorable="d"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             x:Class="SQLRestoreSOS.App.Views.AdvancedRestoreView"
             x:DataType="vm:MainWindowViewModel">

    <UserControl.DataTemplates>
        <DataTemplate DataType="vm:GroupHeaderRow">
            <TextBlock Text="{Binding Title}" FontWeight="Bold" FontSize="14" Margin="0,14,0,4" />
        </DataTemplate>

        <DataTemplate DataType="vm:BitParameterRow">
            <CheckBox Content="{Binding Name}" IsChecked="{Binding Value}" ToolTip.Tip="{Binding HelpText}" Margin="0,2" />
        </DataTemplate>

        <DataTemplate DataType="vm:IntParameterRow">
            <Grid ColumnDefinitions="200,*" Margin="0,2">
                <TextBlock Grid.Column="0" Text="{Binding Name}" VerticalAlignment="Center" ToolTip.Tip="{Binding HelpText}" />
                <NumericUpDown Grid.Column="1" Value="{Binding Value}" FormatString="0" HorizontalAlignment="Left" Width="160" />
            </Grid>
        </DataTemplate>

        <DataTemplate DataType="vm:StringParameterRow">
            <Grid ColumnDefinitions="200,*" Margin="0,2">
                <TextBlock Grid.Column="0" Text="{Binding Name}" VerticalAlignment="Center" ToolTip.Tip="{Binding HelpText}" />
                <TextBox Grid.Column="1" Text="{Binding Value}" />
            </Grid>
        </DataTemplate>

        <DataTemplate DataType="vm:PathParameterRow">
            <Grid ColumnDefinitions="200,*" Margin="0,2">
                <TextBlock Grid.Column="0" Text="{Binding Name}" VerticalAlignment="Center" ToolTip.Tip="{Binding HelpText}" />
                <TextBox Grid.Column="1" Text="{Binding Value}" PlaceholderText="path" />
            </Grid>
        </DataTemplate>

        <DataTemplate DataType="vm:DateTimeParameterRow">
            <Grid ColumnDefinitions="200,*" Margin="0,2">
                <TextBlock Grid.Column="0" Text="{Binding Name}" VerticalAlignment="Center" ToolTip.Tip="{Binding HelpText}" />
                <DatePicker Grid.Column="1" SelectedDate="{Binding Value}" HorizontalAlignment="Left" />
            </Grid>
        </DataTemplate>
    </UserControl.DataTemplates>

    <ScrollViewer>
        <ItemsControl ItemsSource="{Binding AdvancedRows}" Margin="16" />
    </ScrollViewer>
</UserControl>
